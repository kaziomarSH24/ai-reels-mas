[
    {
        "start_time": "00:00:13.400",
        "end_time": "00:00:18.960",
        "text": "Really, Mary Clarence, were you a choir mistress?"
    },
    {
        "start_time": "00:00:17.240",
        "end_time": "00:00:22.480",
        "text": "Sort of freelance."
    },
    {
        "start_time": "00:00:18.960",
        "end_time": "00:00:24.680",
        "text": "Freelance? Really?"
    },
    {
        "start_time": "00:00:22.480",
        "end_time": "00:00:26.360",
        "text": "Oh."
    },
    {
        "start_time": "00:00:24.680",
        "end_time": "00:00:28.640",
        "text": "You don't think I see."
    },
    {
        "start_time": "00:00:26.360",
        "end_time": "00:00:30.560",
        "text": "You think I took vows yesterday."
    },
    {
        "start_time": "00:00:28.640",
        "end_time": "00:00:34.280",
        "text": "I know what you're up to. You and Reverend Mother."
    },
    {
        "start_time": "00:00:32.520",
        "end_time": "00:00:35.760",
        "text": "Uh what?"
    },
    {
        "start_time": "00:00:34.280",
        "end_time": "00:00:37.760",
        "text": "You're a ringer."
    },
    {
        "start_time": "00:00:35.760",
        "end_time": "00:00:40.640",
        "text": "She brought you here to replace me. Out with the old."
    },
    {
        "start_time": "00:00:41.400",
        "end_time": "00:00:45.000",
        "text": "Oh, could you help us, Mary Clarence?"
    },
    {
        "start_time": "00:00:43.520",
        "end_time": "00:00:47.280",
        "text": "Mary Lazarus, you're terrific, but we could really use some help."
    },
    {
        "start_time": "00:00:46.200",
        "end_time": "00:00:49.960",
        "text": "Please, you've heard us."
    },
    {
        "start_time": "00:00:47.280",
        "end_time": "00:00:49.960",
        "text": "We're terrible."
    },
    {
        "start_time": "00:00:52.360",
        "end_time": "00:00:58.600",
        "text": "Well,"
    },
    {
        "start_time": "00:00:54.160",
        "end_time": "00:00:58.600",
        "text": "there's a word for this, mutiny."
