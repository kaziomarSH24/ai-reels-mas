[
    {
        "start_time": "00:00:08.960",
        "end_time": "00:00:12.870",
        "text": "- Must be a thread I'm not on."
    },
    {
        "start_time": "00:00:17.628",
        "end_time": "00:00:18.128",
        "text": "Hey, Ali."
    },
    {
        "start_time": "00:00:18.128",
        "end_time": "00:00:20.956",
        "text": "What's so funny?"
    },
    {
        "start_time": "00:00:20.956",
        "end_time": "00:00:22.844",
        "text": "- Oh my god, I'm crying."
    },
    {
        "start_time": "00:00:24.740",
        "end_time": "00:00:27.010",
        "text": "- What are you all hiding?"
    },
    {
        "start_time": "00:00:27.010",
        "end_time": "00:00:29.470",
        "text": "- Oh man, this thread makes my day every day."
    },
    {
        "start_time": "00:00:29.470",
        "end_time": "00:00:31.430",
        "text": "- I want my day made every day."
    },
    {
        "start_time": "00:00:34.706",
        "end_time": "00:00:38.708",
        "text": "OK, at least Grant's out of the loop, too."
    },
    {
        "start_time": "00:00:39.680",
        "end_time": "00:00:41.840",
        "text": "- Grant, check the thread."
    },
    {
        "start_time": "00:00:44.540",
        "end_time": "00:00:48.210",
        "text": "- This is very funny, and we're better friends because of it."
    },
    {
        "start_time": "00:00:50.640",
        "end_time": "00:00:52.540",
        "text": "- This is about me."
    },
    {
        "start_time": "00:00:52.540",
        "end_time": "00:00:54.130",
        "text": "Everyone's laughing at me."
    },
    {
        "start_time": "00:00:54.130",
        "end_time": "00:00:57.590",
        "text": "I don't know what it's about, but everyone is laughing at me."
    },
    {
        "start_time": "00:01:06.140",
        "end_time": "00:01:06.640",
        "text": "Sorry."
    },
    {
        "start_time": "00:01:18.520",
        "end_time": "00:01:21.040",
        "text": "- Oh, this chat is out of control, you guys."
    },
    {
        "start_time": "00:01:21.040",
        "end_time": "00:01:22.990",
        "text": "- I knew you would specifically love it."
    },
    {
        "start_time": "00:01:22.990",
        "end_time": "00:01:23.520",
        "text": "- Yeah."
    },
    {
        "start_time": "00:01:23.520",
        "end_time": "00:01:26.020",
        "text": "- You guys get me."
    },
    {
        "start_time": "00:01:26.020",
        "end_time": "00:01:30.455",
        "text": "- How many people are on this thread?"
    },
    {
        "start_time": "00:01:30.455",
        "end_time": "00:01:32.250",
        "text": "Everyone's laughing at Lily, huh?"
    },
    {
        "start_time": "00:01:32.250",
        "end_time": "00:01:36.541",
        "text": "Well, two can play at this game."
    },
    {
        "start_time": "00:01:42.880",
        "end_time": "00:01:44.457",
        "text": "- Hey, Lily?"
    },
    {
        "start_time": "00:01:44.457",
        "end_time": "00:01:46.540",
        "text": "Can we keep the writers channel strictly business?"
    },
    {
        "start_time": "00:01:46.540",
        "end_time": "00:01:49.120",
        "text": "- Yeah, seconded, it just gets a little cluttered."
    },
    {
        "start_time": "00:01:49.120",
        "end_time": "00:01:52.480",
        "text": "- Also that was incredibly rude, and you owe Ali an apology."
    },
    {
        "start_time": "00:01:52.480",
        "end_time": "00:01:55.813",
        "text": "- Oh, I'm sorry."
    },
    {
        "start_time": "00:01:55.813",
        "end_time": "00:01:56.719",
        "text": "- That's fine."
    },
    {
        "start_time": "00:01:59.890",
        "end_time": "00:02:02.740",
        "text": "- I just want to know why am I excluded from the fun chat?"
    },
    {
        "start_time": "00:02:02.740",
        "end_time": "00:02:03.880",
        "text": "Are you all laughing at me?"
    },
    {
        "start_time": "00:02:03.880",
        "end_time": "00:02:06.047",
        "text": "If you're not laughing at me, why am I not the chat?"
    },
    {
        "start_time": "00:02:06.047",
        "end_time": "00:02:07.130",
        "text": "Because I love to laugh."
    },
    {
        "start_time": "00:02:07.130",
        "end_time": "00:02:08.380",
        "text": "LOL, love to laugh."
    },
    {
        "start_time": "00:02:08.380",
        "end_time": "00:02:09.418",
        "text": "That's me."
    },
    {
        "start_time": "00:02:09.418",
        "end_time": "00:02:10.294",
        "text": "Ha ha ha ha ha."
    },
    {
        "start_time": "00:02:10.294",
        "end_time": "00:02:12.000",
        "text": "Laughing Lily, you know?"
    },
    {
        "start_time": "00:02:12.000",
        "end_time": "00:02:15.486",
        "text": "Why are you all mocking me?"
    },
    {
        "start_time": "00:02:16.740",
        "end_time": "00:02:18.000",
        "text": "- Yoo-hoo."
    },
    {
        "start_time": "00:02:18.000",
        "end_time": "00:02:20.110",
        "text": "CEO alert."
    },
    {
        "start_time": "00:02:20.110",
        "end_time": "00:02:27.160",
        "text": "Hey, I'm just dropping in to let you scamps know what a hearty chuckle I had thanks to the group chat today."
    },
    {
        "start_time": "00:02:27.160",
        "end_time": "00:02:29.530",
        "text": "Raises for everyone in the group chat."
    },
    {
        "start_time": "00:02:29.530",
        "end_time": "00:02:30.566",
        "text": "- Oh!"
    },
    {
        "start_time": "00:02:30.566",
        "end_time": "00:02:31.940",
        "text": "- Yay!"
    },
    {
        "start_time": "00:02:31.940",
        "end_time": "00:02:33.770",
        "text": "- That's it!"
    },
    {
        "start_time": "00:02:33.770",
        "end_time": "00:02:36.014",
        "text": "- Oh, yeah, I want a hug."
    },
    {
        "start_time": "00:02:36.014",
        "end_time": "00:02:39.000",
        "text": "- Ahh!"
    },
    {
        "start_time": "00:02:39.000",
        "end_time": "00:02:40.763",
        "text": "You all pushed me to this, OK?"
    },
    {
        "start_time": "00:02:40.763",
        "end_time": "00:02:45.700",
        "text": "I didn't want to do it, but I'm going to look at one of your screens."
    },
    {
        "start_time": "00:02:45.700",
        "end_time": "00:02:48.530",
        "text": "I deserve to know what everyone is bullying me about."
    },
    {
        "start_time": "00:02:48.530",
        "end_time": "00:02:49.240",
        "text": "Yes."
    },
    {
        "start_time": "00:02:49.240",
        "end_time": "00:02:50.440",
        "text": "- No, no, no."
    },
    {
        "start_time": "00:02:50.440",
        "end_time": "00:02:52.275",
        "text": "- Come on, come on!"
    },
    {
        "start_time": "00:02:52.275",
        "end_time": "00:02:54.140",
        "text": "What is that?"
    },
    {
        "start_time": "00:02:54.140",
        "end_time": "00:02:57.940",
        "text": "- It's the photo of a boy from the sixth sense asking Bruce"
    },
    {
        "start_time": "00:02:57.940",
        "end_time": "00:03:02.957",
        "text": "Willis if he wants to see his teeth, and he says no not really, so he just kind of shows"
    },
    {
        "start_time": "00:03:02.957",
        "end_time": "00:03:03.540",
        "text": "him his teeth."
    },
    {
        "start_time": "00:03:07.896",
        "end_time": "00:03:10.316",
        "text": "- Oh, yeah."
    },
    {
        "start_time": "00:03:15.640",
        "end_time": "00:03:22.590",
        "text": "[INAUDIBLE] Ooh."
    },
    {
        "start_time": "00:03:22.590",
        "end_time": "00:03:24.110",
        "text": "Oh."
    },
    {
        "start_time": "00:03:24.110",
        "end_time": "00:03:25.040",
        "text": "I'm so sorry."
    },
    {
        "start_time": "00:03:25.040",
        "end_time": "00:03:29.420",
        "text": "I was getting so paranoid because I thought you guys were making fun of me,"
    },
    {
        "start_time": "00:03:29.420",
        "end_time": "00:03:31.520",
        "text": "because I wasn't in the thread."
    },
    {
        "start_time": "00:03:31.520",
        "end_time": "00:03:33.920",
        "text": "I'm sorry, CEO."
    },
    {
        "start_time": "00:03:33.920",
        "end_time": "00:03:37.680",
        "text": "- Actually it's OK, I'm still very rich."
    },
    {
        "start_time": "00:03:37.680",
        "end_time": "00:03:38.180",
        "text": "- Yeah."
    },
    {
        "start_time": "00:03:41.300",
        "end_time": "00:03:44.180",
        "text": "- Oh boy, do I have egg on my face."
    },
    {
        "start_time": "00:03:44.180",
        "end_time": "00:03:45.620",
        "text": "Why didn't you guys send it to me?"
    },
    {
        "start_time": "00:03:45.620",
        "end_time": "00:03:47.800",
        "text": "- Because we hate you."
    }
]