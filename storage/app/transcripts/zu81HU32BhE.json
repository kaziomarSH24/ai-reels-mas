[
    {
        "start_time": "00:00:03.440",
        "end_time": "00:00:08.840",
        "text": "Recruits, attention."
    },
    {
        "start_time": "00:00:06.200",
        "end_time": "00:00:14.240",
        "text": "Gentlemen, I'm Agent Carter. I supervise all operations for this division."
    },
    {
        "start_time": "00:00:11.120",
        "end_time": "00:00:15.760",
        "text": "What's with the accent, Queen Victoria?"
    },
    {
        "start_time": "00:00:14.240",
        "end_time": "00:00:17.840",
        "text": "Thought I was signing up for the US Army."
    },
    {
        "start_time": "00:00:16.400",
        "end_time": "00:00:19.600",
        "text": "What's your name, soldier?"
    },
    {
        "start_time": "00:00:17.840",
        "end_time": "00:00:22.480",
        "text": "Gilmore Hodge, your majesty."
    },
    {
        "start_time": "00:00:19.600",
        "end_time": "00:00:22.480",
        "text": "Step forward, Hodge."
    },
    {
        "start_time": "00:00:23.120",
        "end_time": "00:00:26.160",
        "text": "Put your right foot forward."
    },
    {
        "start_time": "00:00:26.320",
        "end_time": "00:00:30.640",
        "text": "Can you get a rassa?"
    },
    {
        "start_time": "00:00:29.000",
        "end_time": "00:00:33.120",
        "text": "Cuz I got a few moves I know you'll like."
    },
    {
        "start_time": "00:00:34.320",
        "end_time": "00:00:37.360",
        "text": "Agent Carter."
    },
    {
        "start_time": "00:00:35.960",
        "end_time": "00:00:38.840",
        "text": "Carter, Phillips."
    },
    {
        "start_time": "00:00:37.360",
        "end_time": "00:00:42.480",
        "text": "I can see that you are breaking in the candidates. That's good."
    },
    {
        "start_time": "00:00:41.080",
        "end_time": "00:00:45.240",
        "text": "Get your ass up out of that dirt and stand in that line of attention till"
    },
    {
        "start_time": "00:00:43.720",
        "end_time": "00:00:47.760",
        "text": "somebody comes tells you what to do."
    },
    {
        "start_time": "00:00:45.240",
        "end_time": "00:00:47.760",
        "text": "Yes, sir."
    },
    {
        "start_time": "00:00:50.040",
        "end_time": "00:00:57.920",
        "text": "General Patton has said wars are fought with weapons, but they"
    },
    {
        "start_time": "00:00:54.920",
        "end_time": "00:01:02.280",
        "text": "are won by men. We are going to win this"
    },
    {
        "start_time": "00:00:57.920",
        "end_time": "00:01:02.280",
        "text": "war because we have the best men."
    },
    {
        "start_time": "00:01:04.600",
        "end_time": "00:01:07.920",
        "text": "And because they are going to get better."
    },
    {
        "start_time": "00:01:06.840",
        "end_time": "00:01:11.840",
        "text": "Much better."
    },
    {
        "start_time": "00:01:09.480",
        "end_time": "00:01:15.480",
        "text": "The Strategic Scientific Reserve is an Allied effort"
    },
    {
        "start_time": "00:01:13.480",
        "end_time": "00:01:18.280",
        "text": "made up of the best minds in the free world."
    },
    {
        "start_time": "00:01:16.960",
        "end_time": "00:01:24.640",
        "text": "Our goal is to create the best army in history."
    },
    {
        "start_time": "00:01:20.680",
        "end_time": "00:01:24.640",
        "text": "But every army starts with one man."
    },
    {
        "start_time": "00:01:24.680",
        "end_time": "00:01:29.600",
        "text": "At the end of this week, we will choose that man."
    },
    {
        "start_time": "00:01:27.680",
        "end_time": "00:01:33.400",
        "text": "He will be the first"
    },
    {
        "start_time": "00:01:29.600",
        "end_time": "00:01:33.400",
        "text": "in a new breed of super soldiers."
    },
    {
        "start_time": "00:01:37.480",
        "end_time": "00:01:41.120",
        "text": "Roger, get my raffle OUT OF THE MUD."
    },
    {
        "start_time": "00:01:40.040",
        "end_time": "00:01:43.640",
        "text": "NAY."
    },
    {
        "start_time": "00:01:41.120",
        "end_time": "00:01:47.600",
        "text": "We'll personally escort Adolf Hitler through the gates of hell."
    },
    {
        "start_time": "00:01:45.120",
        "end_time": "00:01:48.640",
        "text": "Pick up the pace, ladies."
    },
    {
        "start_time": "00:01:47.600",
        "end_time": "00:01:50.080",
        "text": "Let's go."
    },
    {
        "start_time": "00:01:48.640",
        "end_time": "00:01:51.600",
        "text": "Let's go."
    },
    {
        "start_time": "00:01:50.080",
        "end_time": "00:01:52.640",
        "text": "Double time."
    },
    {
        "start_time": "00:01:51.600",
        "end_time": "00:01:53.760",
        "text": "Come on."
    },
    {
        "start_time": "00:01:52.640",
        "end_time": "00:01:54.800",
        "text": "Faster."
    },
    {
        "start_time": "00:01:53.760",
        "end_time": "00:01:55.960",
        "text": "Faster."
    },
    {
        "start_time": "00:01:54.800",
        "end_time": "00:01:57.520",
        "text": "Move."
    },
    {
        "start_time": "00:01:55.960",
        "end_time": "00:02:00.040",
        "text": "Move."
    },
    {
        "start_time": "00:01:57.520",
        "end_time": "00:02:01.720",
        "text": "WHAT? HALT. GO!"
    },
    {
        "start_time": "00:02:00.040",
        "end_time": "00:02:06.440",
        "text": "THAT FLAG MEANS YOU'RE ONLY AT THE HALFWAY POINT. FIRST MAN TO BRING IT TO"
    },
    {
        "start_time": "00:02:03.920",
        "end_time": "00:02:09.120",
        "text": "ME GETS A RIDE BACK WITH AGENT CARTER."
    },
    {
        "start_time": "00:02:06.440",
        "end_time": "00:02:09.120",
        "text": "MOVE! MOVE!"
    },
    {
        "start_time": "00:02:09.320",
        "end_time": "00:02:13.240",
        "text": "COME ON, GET OUT THERE!"
    },
    {
        "start_time": "00:02:11.360",
        "end_time": "00:02:18.880",
        "text": "THAT'S ALL YOU GOT? THIS ARMY IS IN TROUBLE. GET OUT THERE, HARLEY!"
    },
    {
        "start_time": "00:02:15.920",
        "end_time": "00:02:18.880",
        "text": "COME ON, GET OUT THERE!"
    },
    {
        "start_time": "00:02:20.000",
        "end_time": "00:02:26.040",
        "text": "NOBODY'S GOT THAT FLAG IN 17 YEARS."
    },
    {
        "start_time": "00:02:24.280",
        "end_time": "00:02:31.560",
        "text": "NOW FALL IN, COME ON, FALL IN! LET'S GO! GET BACK IN"
    },
    {
        "start_time": "00:02:28.680",
        "end_time": "00:02:31.560",
        "text": "A FORMATION!"
    },
    {
        "start_time": "00:02:32.320",
        "end_time": "00:02:36.720",
        "text": "ROGERS! I SAID FALL IN!"
    },
    {
        "start_time": "00:02:50.760",
        "end_time": "00:02:53.280",
        "text": "THANK YOU, SIR."
    },
    {
        "start_time": "00:03:01.040",
        "end_time": "00:03:05.320",
        "text": "FASTER, LADIES, come on."
    },
    {
        "start_time": "00:03:03.560",
        "end_time": "00:03:08.400",
        "text": "My grandmother has more life in her, God rest her soul."
    },
    {
        "start_time": "00:03:07.680",
        "end_time": "00:03:09.640",
        "text": "Move it!"
    },
    {
        "start_time": "00:03:08.400",
        "end_time": "00:03:12.880",
        "text": "You're not really thinking about picking Rogers, are you?"
    },
    {
        "start_time": "00:03:10.720",
        "end_time": "00:03:15.640",
        "text": "I wasn't just thinking about it. It's a clear choice."
    },
    {
        "start_time": "00:03:13.720",
        "end_time": "00:03:18.480",
        "text": "You brought a 90-lb asthmatic onto my army base."
    },
    {
        "start_time": "00:03:17.160",
        "end_time": "00:03:23.560",
        "text": "I let it slide. I thought, what the hell, maybe he'll be useful to you, like"
    },
    {
        "start_time": "00:03:19.840",
        "end_time": "00:03:23.560",
        "text": "a durable. Never thought you'd pick him."
    },
    {
        "start_time": "00:03:25.519",
        "end_time": "00:03:29.600",
        "text": "Stick a needle in that kid's arm, it's going to go right through him."
    },
    {
        "start_time": "00:03:27.720",
        "end_time": "00:03:31.000",
        "text": "Come on, girls."
    },
    {
        "start_time": "00:03:29.600",
        "end_time": "00:03:32.440",
        "text": "Look at that."
    },
    {
        "start_time": "00:03:31.000",
        "end_time": "00:03:34.600",
        "text": "He's making me cry."
    },
    {
        "start_time": "00:03:32.440",
        "end_time": "00:03:37.000",
        "text": "I am looking for qualities beyond the physical."
    },
    {
        "start_time": "00:03:35.280",
        "end_time": "00:03:40.280",
        "text": "Do you know how long it took to set up this project? All the grumbling I had to"
    },
    {
        "start_time": "00:03:38.959",
        "end_time": "00:03:42.280",
        "text": "do in front of Senator What's-His-Name's committee?"
    },
    {
        "start_time": "00:03:40.840",
        "end_time": "00:03:44.760",
        "text": "Rogers, I know. I'm well aware of your efforts."
    },
    {
        "start_time": "00:03:42.720",
        "end_time": "00:03:48.840",
        "text": "Then throw me a bone. Hodge passed every test we gave him. He's big, he's fast,"
    },
    {
        "start_time": "00:03:47.360",
        "end_time": "00:03:49.800",
        "text": "he obeys orders, he's a soldier."
    },
    {
        "start_time": "00:03:48.840",
        "end_time": "00:03:54.080",
        "text": "He's a bully."
    },
    {
        "start_time": "00:03:49.800",
        "end_time": "00:03:54.080",
        "text": "You You win wars with niceness, doctor."
    },
    {
        "start_time": "00:03:55.960",
        "end_time": "00:04:00.120",
        "text": "You win wars with guts."
    },
    {
        "start_time": "00:04:00.760",
        "end_time": "00:04:04.440",
        "text": "GRENADE!"
    },
    {
        "start_time": "00:04:01.840",
        "end_time": "00:04:04.440",
        "text": "GO, GO, GO!"
    },
    {
        "start_time": "00:04:06.520",
        "end_time": "00:04:10.880",
        "text": "Get away!"
    },
    {
        "start_time": "00:04:08.360",
        "end_time": "00:04:10.880",
        "text": "Get back!"
    },
    {
        "start_time": "00:04:17.120",
        "end_time": "00:04:20.760",
        "text": "Incoming grenade!"
    },
    {
        "start_time": "00:04:19.720",
        "end_time": "00:04:23.640",
        "text": "All clear."
    },
    {
        "start_time": "00:04:20.760",
        "end_time": "00:04:23.640",
        "text": "Back in formation."
    },
    {
        "start_time": "00:04:25.919",
        "end_time": "00:04:31.600",
        "text": "Is this a test?"
    },
    {
        "start_time": "00:04:28.840",
        "end_time": "00:04:31.600",
        "text": "He's still skinny."
    }
]